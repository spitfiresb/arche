/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# The demos are showpieces embedded in the work pages, not destinations of
# their own, and three of them are vendored copies of sites that exist
# elsewhere (unpak-site above all). Indexing them would put ~38 near-duplicate
# pages in front of the five that are actually meant to rank, and would put
# this copy of the Unpak marketing site in competition with the real one.
# Crawling stays allowed so this header is actually seen — see robots.txt.
/demos/*
  X-Robots-Tag: noindex
